set SERVEROUTPUT ON;
set VERIFY off;
 
create or REPLACE PROCEDURE soma (
    P_1 in NUMBER,
    P_2 IN NUMBER)
    IS
    P_T NUMBER(8,2);
    BEGIN
        P_T := P_1 + P_2;
        DBMS_OUTPUT.PUT_LINE(P_1 || '+' || P_2 || '=' || P_T);
END SOMA;
 
EXEC SOMA(2,2);

